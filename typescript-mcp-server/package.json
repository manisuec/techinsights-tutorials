{
  "name": "typescript-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A production-shaped Model Context Protocol server in TypeScript: Streamable HTTP transport, OAuth bearer auth, rate limiting, and error boundaries.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
