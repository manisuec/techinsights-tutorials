{
  "name": "node-parallelism-bench",
  "version": "1.0.0",
  "description": "Benchmarks and production patterns for Node.js worker_threads, cluster, and child_process",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "prestart:no-cluster": "npm run build",
    "start": "node dist/server/cluster.js",
    "start:no-cluster": "node dist/server/app.js",
    "dev": "tsc --watch",
    "bench:spawn": "node bench/spawn-cost.mjs",
    "bench:mem": "node bench/mem-cost.mjs",
    "bench:ipc": "node bench/ipc-latency.mjs",
    "bench:throughput": "node bench/throughput.mjs",
    "bench": "npm run bench:spawn && npm run bench:mem && npm run bench:ipc"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "autocannon": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
