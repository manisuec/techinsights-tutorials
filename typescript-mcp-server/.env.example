# Copy to .env and fill in. The server validates all of this at boot and
# refuses to start on a bad value, rather than failing on the first request.

NODE_ENV=development
PORT=3000

# Public base URL, used to advertise the protected-resource metadata document.
PUBLIC_URL=http://localhost:3000

# Comma-separated. Empty means "reject every request that carries an Origin
# header" -- browsers send one, native clients usually do not.
ALLOWED_ORIGINS=https://claude.ai

# --- Auth: pick ONE mode ---

# Mode 1 (production): verify RS256/ES256 access tokens against a JWKS.
# AUTH_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
# AUTH_ISSUER=https://your-tenant.auth0.com/
# AUTH_AUDIENCE=https://mcp.example.com

# Mode 2 (local development only): a single static bearer token.
# Refused outright when NODE_ENV=production.
DEV_AUTH_TOKEN=local-dev-token-change-me

# --- Limits ---
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1
SESSION_IDLE_MS=1800000
